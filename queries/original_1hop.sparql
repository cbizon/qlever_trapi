PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?subject1 ?predicate1 ?object1
WHERE {
  {
    ?edge1 a rdf:Statement ;
           rdf:subject __START__ ;
           rdf:predicate ?predicate1 ;
           rdf:object __END__ .
    BIND(__START__ AS ?subject1)
    BIND(__END__ AS ?object1)
  }
  UNION
  {
    ?edge1 a rdf:Statement ;
           rdf:subject __END__ ;
           rdf:predicate ?predicate1 ;
           rdf:object __START__ .
    BIND(__END__ AS ?subject1)
    BIND(__START__ AS ?object1)
  }
}
__LIMIT__
__OFFSET__
