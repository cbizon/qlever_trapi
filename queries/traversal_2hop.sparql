PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?subject1 ?predicate1 ?object1 ?subject2 ?predicate2 ?object2
WHERE {
  ?traversal_edge1 <https://w3id.org/kgx/traversal/traversal_from> __START__ ;
                   <https://w3id.org/kgx/traversal/traversal_to> ?node1 .
  ?traversal_edge1 a rdf:Statement ;
                   rdf:subject ?subject1 ;
                   rdf:predicate ?predicate1 ;
                   rdf:object ?object1 .

  ?traversal_edge2 <https://w3id.org/kgx/traversal/traversal_from> ?node1 ;
                   <https://w3id.org/kgx/traversal/traversal_to> __END__ .
  ?traversal_edge2 a rdf:Statement ;
                   rdf:subject ?subject2 ;
                   rdf:predicate ?predicate2 ;
                   rdf:object ?object2 .
}
__LIMIT__
__OFFSET__
