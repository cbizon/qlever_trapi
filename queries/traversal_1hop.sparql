PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?subject1 ?predicate1 ?object1
WHERE {
  ?traversal_edge1 <https://w3id.org/kgx/traversal/traversal_from> __START__ ;
                   <https://w3id.org/kgx/traversal/traversal_to> __END__ .
  ?traversal_edge1 a rdf:Statement ;
                   rdf:subject ?subject1 ;
                   rdf:predicate ?predicate1 ;
                   rdf:object ?object1 .
}
__LIMIT__
__OFFSET__
